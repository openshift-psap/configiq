# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AIConfigurator API gateway — used by the app/api/ proxy routes (server-side)
AICONFIGURATOR_GATEWAY_URL=https://aiconfigurator.dev
AICONFIGURATOR_TIMEOUT_SECONDS=90

# AIConfigurator API — used by lib/hooks/useAicCatalog.ts (client-side, direct)
NEXT_PUBLIC_AICONFIGURATOR_API_URL=https://aiconfigurator.dev

