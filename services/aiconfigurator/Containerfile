# AIConfigurator REST API service.
#
# Build context is services/ (not this directory) so the image can pull in the
# shared configiq-py package alongside this service. Build from the repo root:
#
#   podman build -f services/aiconfigurator/Containerfile -t aiconfigurator services/
#
# Unlike the aiconfigurator monorepo's Containerfile (a multi-stage Rust/maturin
# wheel *builder*), this image just installs the already-published aiconfigurator
# SDK wheels from the Red Hat fork's GitHub Releases and layers the thin FastAPI
# wrapper (plus the shared configiq package) on top. Bump the SDK by re-pointing
# AIC_WHEELS_URL at a different release tag; no version is pinned here.

FROM python:3.12-slim

# Link the GHCR package to this repo (configiq), not the SDK-wheels fork whose
# name it shares. Set on package creation; add here so future publishes resolve
# to configiq/packages rather than redhat-performance/aiconfigurator.
LABEL org.opencontainers.image.source=https://github.com/redhat-performance/configiq

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:${PATH}

# GitHub Release that hosts the aiconfigurator / aiconfigurator-core wheels.
# Pinned to an immutable per-build release so the 0.11.0 pins in pyproject.toml
# always resolve; the rolling deploy-api-latest tag has served incompatible
# builds (an unpinned rebuild once backtracked to 0.1.1). Bump this in lockstep
# with the version pins in pyproject.toml when moving to a newer SDK.
ARG AIC_WHEELS_URL=https://github.com/redhat-performance/aiconfigurator/releases/expanded_assets/deploy-api-v0.11.0+5b0ee59e

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip

# Shared ConfigIQ library, with the observability + MCP extras so /metrics,
# tracing, and the MCP server light up in the deployed container.
COPY configiq-py /src/configiq-py
RUN /opt/venv/bin/pip install --no-cache-dir "/src/configiq-py[otel,mcp]"

# Runtime deps, read from pyproject.toml (single source of truth) by the shared
# installer — incl. the aiconfigurator SDK + its Rust-compiled core, resolved as
# wheels from the fork's release assets via --find-links. Copy pyproject.toml
# alone first so this layer only rebuilds when the deps change. `python` here is
# the venv's (PATH=/opt/venv/bin), so pip installs into /opt/venv.
COPY scripts/install-deps.py aiconfigurator/pyproject.toml /tmp/
RUN python /tmp/install-deps.py /tmp/pyproject.toml --find-links "${AIC_WHEELS_URL}"

# Thin REST wrapper. CMD imports it as api_service.app:app.
COPY aiconfigurator/tools/api_service /app/api_service

# OpenShift / rootless compatibility: numeric UID 1001, group 0 (root group),
# group-writable so an arbitrary assigned UID can still write.
RUN chown -R 1001:0 /app /opt/venv \
    && chmod -R g=u /app /opt/venv

USER 1001

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD /opt/venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://localhost:7860/systems', timeout=5)" || exit 1

CMD ["uvicorn", "api_service.app:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "2"]
